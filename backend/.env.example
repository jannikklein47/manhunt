# Copy to `.env` and adjust — loaded automatically by the game server
# (variables already set in the shell keep precedence).

# PostgreSQL connection for the match replay system.
# Local dev (docker run ... -p 5432:5432 postgres:17-alpine):
DATABASE_URL=postgres://manhunt:manhunt@localhost:5432/manhunt
# Compose-internal (backend container → db container):
# DATABASE_URL=postgres://manhunt:manhunt@db:5432/manhunt

# HTTP port of the game server (dev default 3000)
# PORT=3000
